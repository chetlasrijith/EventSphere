# --- Database ---
DATABASE_URL=postgresql+asyncpg://eventsphere:eventsphere@localhost:5432/eventsphere

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=15

# --- App ---
ENVIRONMENT=development
# Set to true to echo every SQL statement. Very noisy; off by default.
DEBUG=false
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Session cookie SameSite policy.
#   lax  -- API and frontend on the same origin (local dev). Use this.
#   none -- API on a different domain than the frontend, e.g. Vercel hosting
#           the React app and Render hosting FastAPI. Browsers withhold a Lax
#           cookie from cross-site fetch calls, so every authenticated request
#           would 401 even after a successful login. Requires HTTPS.
COOKIE_SAMESITE=lax

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- Database ---
DATABASE_URL=postgresql+asyncpg://eventsphere:eventsphere@localhost:5432/eventsphere

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=insecure-development-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=15

# --- App ---
ENVIRONMENT=development
# Set to true to echo every SQL statement. Very noisy; off by default.
DEBUG=false
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Session cookie SameSite policy.
#   lax  -- recommended when the frontend proxies /api to this service, so the
#           browser sees one origin.
#   none -- only for a direct cross-site browser-to-API deployment; requires
#           HTTPS and may still be blocked by third-party-cookie restrictions.
COOKIE_SAMESITE=lax

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=